  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/me-sharif-hasan/secret-manager-mcp-for-ai-agents.git"
  },
  "license": "MIT",
  "author": "Sharif Hasan <me.sharif.hasan@gmail.com>",
  "type": "module",
  "bin": {
